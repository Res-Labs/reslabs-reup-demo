# Demo Store. Set MPP_SECRET_KEY (openssl rand -hex 32) and the Moderato address that receives payments.
MPP_SECRET_KEY=YOUR_RANDOM_SECRET
MPP_RECIPIENT=0xYOUR_TESTNET_RECIPIENT_ADDRESS
DEMO_BATCH_ID=00000000-0000-4000-8000-000000000000
DEMO_SKU=DEMO-10MG
DEMO_PRICE=1.00
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# Res Labs session. These point at `pnpm mock`. For real taps, use https://verify.reslabs.ai and https://api.reslabs.ai/v/p/session.
RESLABS_LINK_ORIGIN=http://localhost:4010
RESLABS_SESSION_URL=http://localhost:4010/v/p/session

# Optional, shown with their defaults. STORE_DB_PATH and STORE_DIST_DIR are relative to apps/store. MOCK_PORT must match RESLABS_LINK_ORIGIN.
# STORE_DB_PATH=data/store.db
# STORE_DIST_DIR=.next
# MOCK_PORT=4010

# MCP server. It does not read this file. Pass these and MPP_RECIPIENT with `claude mcp add --env`, or in the Desktop Extension settings.
# AGENT_KEY=0xYOUR_TESTNET_AGENT_PRIVATE_KEY
# STORE_URL=http://localhost:3000
