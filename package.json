{
  "name": "reslabs-reup-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev:store": "pnpm --filter @reup/store dev",
    "mock": "tsx --env-file-if-exists=.env scripts/mock-session.ts",
    "reconcile": "tsx --env-file-if-exists=.env scripts/reconcile.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@reup/chain-proof": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "better-sqlite3": "^13",
    "tsx": "^4",
    "typescript": "^5.9"
  }
}
