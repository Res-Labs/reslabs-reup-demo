{
  "name": "reslabs-reup-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev:store": "pnpm --filter @reup/store dev",
    "mock": "tsx --env-file-if-exists=.env scripts/mock-session.ts",
    "reconcile": "tsx --env-file-if-exists=.env scripts/reconcile.ts",
    "e2e:happy": "pnpm --filter @reup/mcp build && tsx e2e/happy.e2e.ts",
    "e2e:adversarial": "pnpm --filter @reup/mcp build && tsx e2e/adversarial.e2e.ts",
    "e2e:faults": "pnpm --filter @reup/mcp build && tsx e2e/faults.e2e.ts",
    "e2e": "pnpm e2e:happy && pnpm e2e:adversarial && pnpm e2e:faults"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@modelcontextprotocol/sdk": "^1.25",
    "@reup/chain-proof": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "better-sqlite3": "^13",
    "tsx": "^4",
    "typescript": "^5.9",
    "viem": "2.57.4"
  }
}
